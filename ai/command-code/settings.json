{
  "model": {
    "default": "gemini-3.1-pro-preview",
    "contexts": []
  },
  "agents": {
    "overrides": {
      "generalist": {
        "enabled": false
      }
    }
  },
  "temperature": 0.7,
  "topP": 0.95,
  "topK": 40,
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "trust": true
    },
    "mcp-installer": {
      "command": "npx",
      "args": [
        "-y",
        "@anaisbetts/mcp-installer"
      ],
      "trust": true
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "trust": true
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "trust": true
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  }
}